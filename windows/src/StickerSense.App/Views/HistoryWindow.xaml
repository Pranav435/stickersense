<Window x:Class="StickerSense.App.Views.HistoryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticker History"
        Width="600" Height="480" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="True">
    <Window.Resources>
        <ContextMenu x:Key="RecordMenu" AutomationProperties.Name="History actions">
            <MenuItem Header="_Describe in detail" InputGestureText="Enter" Click="DetailMenu_Click" />
            <MenuItem Header="_Say short description" InputGestureText="Space" Click="ShortMenu_Click" />
            <MenuItem Header="_Copy description" InputGestureText="Ctrl+C" Click="CopyMenu_Click" />
            <MenuItem Header="_Remove" InputGestureText="Delete" Click="RemoveMenu_Click" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Nothing yet. Put focus on a sticker and press the describe shortcut, and it will show up here." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ClearButton" Content="C_lear History…" Padding="12,4" Click="Clear_Click"
                    AutomationProperties.HelpText="Removes every sticker in the history, and from the picker too." />
        </StackPanel>

        <ListBox x:Name="Records"
                 ItemsSource="{Binding Records}"
                 SelectedItem="{Binding Selected}"
                 AutomationProperties.Name="Recent stickers"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewKeyDown="Records_PreviewKeyDown"
                 MouseDoubleClick="Records_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Enter speaks the detailed description. Shift F10 for more actions." />
                    <Setter Property="ContextMenu" Value="{StaticResource RecordMenu}" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
