<Window x:Class="StickerSense.App.Views.HomeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickerSense"
        Width="560" Height="640" MinWidth="420" MinHeight="400"
        ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
        </Style>
        <!-- Read-only text boxes: Tab reaches them and screen readers read name and value. -->
        <Style x:Key="Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="18,4,18,18">
            <TextBlock Style="{StaticResource Heading}" Text="Status" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="On-device model" Margin="0,2,16,2" VerticalAlignment="Top" />
                <TextBox x:Name="ModelStatus" Grid.Column="1" Style="{StaticResource Value}"
                         Text="{Binding ModelText, Mode=OneWay}" AutomationProperties.Name="On-device model" />
                <TextBlock Grid.Row="1" Text="Sticker library" Margin="0,2,16,2" VerticalAlignment="Top" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"
                         Text="{Binding LibraryText, Mode=OneWay}" AutomationProperties.Name="Sticker library" />
            </Grid>
            <CheckBox Margin="0,6,0,0" Content="Describe stickers _automatically" IsChecked="{Binding Settings.AutoDescribe}"
                      AutomationProperties.HelpText="Stickers and GIFs in chats are described when focus rests on them." />

            <TextBlock Style="{StaticResource Heading}" Text="Open" />
            <Button Content="Open Sticker _Picker" Click="Picker_Click" />
            <Button Content="Sticker _History" Click="History_Click" />
            <Button Content="_Settings" Click="Settings_Click" />
            <Button Content="Setup and P_ermissions" Click="Setup_Click" />
            <Button Content="Hear _What StickerSense Can Do" Click="Help_Click"
                    AutomationProperties.HelpText="Speaks every shortcut, and whether automatic descriptions are on." />

            <TextBlock Style="{StaticResource Heading}" Text="Shortcuts, from any app" />
            <ListBox ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="Shortcuts, from any app"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding What}" TextWrapping="Wrap" MaxWidth="320" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBox Margin="0,14,0,0" Style="{StaticResource Value}" AutomationProperties.Name="Note"
                     Text="StickerSense keeps running in the notification area when this window is closed." />
        </StackPanel>
    </ScrollViewer>
</Window>
